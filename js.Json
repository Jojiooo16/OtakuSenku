        {
          "id": "avaliacoes",
          "title": "Avaliações dos clientes",
          "reviews": [
            {
              "name": "Marco.M",
              "rating_stars": 5,
              "text": "Eu amei a experiência no Otaku Senku! Os sushis são deliciosos e as referências aos animes deixam tudo mais divertido. Já quero experimentar o cardápio inteiro! Esse Respiração da Besta foi o que eu mais gostei.",
              "image": "espeto_peixe_empanado_espada_inosuke 1.png"
            },
            {
              "name": "Bianca.A",
              "rating_stars": 5,
              "text": "Sou fã de anime e achei a ideia incrível! Os pratos são criativos, muito bonitos e saborosos. O ambiente temático deixa a experiência ainda melhor. Recomendo demais!Meu prato favorito é Thorn Princess.",
              "image": "doce_espinho_da_rosa_yor_quadrado 1.png"
            },
            {
              "name": "Leonardo.M",
              "rating_stars": 5,
              "text": "“O Otaku Senku conquistou meu coração! A mistura de sushi com referências dos meus animes favoritos é perfeita. Tudo é feito com muita criatividade. Com certeza voltarei! minha bebida favorita foi IRA.",
              "image": "image 6.png"
            }
          ],
          "banner_image": "Avalia-es-04-11-2026.png"
        },
